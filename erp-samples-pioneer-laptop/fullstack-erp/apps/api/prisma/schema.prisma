// Manufacturing ERP - Full Prisma Schema
// Covers: Auth, Inventory, Sales/CRM, Purchasing, Finance, HR, Production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// AUTH & USERS
// ─────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole  @default(VIEWER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee     Employee?
  auditLogs    AuditLog[]

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  ACCOUNTANT
  WAREHOUSE_STAFF
  SALES_REP
  PURCHASING_OFFICER
  HR_STAFF
  PRODUCTION_SUPERVISOR
  VIEWER
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entity     String
  entityId   String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────
// INVENTORY & WAREHOUSE
// ─────────────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  parentId    String?
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model UnitOfMeasure {
  id           String    @id @default(cuid())
  name         String    @unique
  abbreviation String    @unique
  type         UomType
  baseRate     Float     @default(1)
  products     Product[]
  bomLines     BomLine[]
  stockMoves   StockMove[]

  @@map("units_of_measure")
}

enum UomType {
  UNIT
  WEIGHT
  VOLUME
  LENGTH
  AREA
  TIME
}

model Warehouse {
  id          String     @id @default(cuid())
  name        String     @unique
  code        String     @unique
  address     String?
  isActive    Boolean    @default(true)
  locations   Location[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("warehouses")
}

model Location {
  id          String      @id @default(cuid())
  warehouseId String
  name        String
  code        String
  type        LocationType @default(INTERNAL)
  isActive    Boolean     @default(true)
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id])
  stockLevels StockLevel[]
  fromMoves   StockMove[] @relation("FromLocation")
  toMoves     StockMove[] @relation("ToLocation")
  createdAt   DateTime    @default(now())

  @@unique([warehouseId, code])
  @@map("locations")
}

enum LocationType {
  INTERNAL
  INCOMING
  OUTGOING
  VIRTUAL
  TRANSIT
}

model Product {
  id              String         @id @default(cuid())
  sku             String         @unique
  name            String
  description     String?
  categoryId      String?
  uomId           String
  type            ProductType    @default(STORABLE)
  costPrice       Float          @default(0)
  salePrice       Float          @default(0)
  reorderPoint    Float          @default(0)
  reorderQty      Float          @default(0)
  isActive        Boolean        @default(true)
  imageUrl        String?
  barcode         String?        @unique
  weight          Float?
  dimensions      Json?

  category        Category?      @relation(fields: [categoryId], references: [id])
  uom             UnitOfMeasure  @relation(fields: [uomId], references: [id])
  stockLevels     StockLevel[]
  stockMoves      StockMove[]
  saleOrderLines  SaleOrderLine[]
  purchaseLines   PurchaseOrderLine[]
  bomLines        BomLine[]
  bomProducts     BillOfMaterial[] @relation("BomFinishedProduct")
  workOrderLines  WorkOrderLine[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("products")
}

enum ProductType {
  STORABLE
  CONSUMABLE
  SERVICE
}

model StockLevel {
  id          String    @id @default(cuid())
  productId   String
  locationId  String
  quantity    Float     @default(0)
  reservedQty Float     @default(0)
  updatedAt   DateTime  @updatedAt

  product     Product   @relation(fields: [productId], references: [id])
  location    Location  @relation(fields: [locationId], references: [id])

  @@unique([productId, locationId])
  @@map("stock_levels")
}

model StockMove {
  id              String          @id @default(cuid())
  reference       String          @unique @default(cuid())
  productId       String
  uomId           String
  fromLocationId  String?
  toLocationId    String?
  quantity        Float
  state           StockMoveState  @default(DRAFT)
  origin          String?
  scheduledDate   DateTime?
  doneDate        DateTime?
  notes           String?

  product         Product         @relation(fields: [productId], references: [id])
  uom             UnitOfMeasure   @relation(fields: [uomId], references: [id])
  fromLocation    Location?       @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocation      Location?       @relation("ToLocation", fields: [toLocationId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([productId])
  @@map("stock_moves")
}

enum StockMoveState {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  DONE
  CANCELLED
}

// ─────────────────────────────────────────
// CUSTOMERS & CRM
// ─────────────────────────────────────────

model Customer {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  email        String?
  phone        String?
  taxId        String?
  creditLimit  Float        @default(0)
  paymentTerms Int          @default(30)
  isActive     Boolean      @default(true)
  address      Json?
  notes        String?

  contacts     Contact[]
  saleOrders   SaleOrder[]
  invoices     Invoice[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("customers")
}

model Contact {
  id          String    @id @default(cuid())
  customerId  String?
  vendorId    String?
  firstName   String
  lastName    String
  email       String?
  phone       String?
  position    String?
  isPrimary   Boolean   @default(false)

  customer    Customer? @relation(fields: [customerId], references: [id])
  vendor      Vendor?   @relation(fields: [vendorId], references: [id])
  createdAt   DateTime  @default(now())

  @@map("contacts")
}

// ─────────────────────────────────────────
// SALES & ORDERS
// ─────────────────────────────────────────

model SaleOrder {
  id            String          @id @default(cuid())
  reference     String          @unique
  customerId    String
  status        SaleOrderStatus @default(DRAFT)
  orderDate     DateTime        @default(now())
  deliveryDate  DateTime?
  subtotal      Float           @default(0)
  taxAmount     Float           @default(0)
  discount      Float           @default(0)
  totalAmount   Float           @default(0)
  notes         String?
  shippingAddr  Json?

  customer      Customer        @relation(fields: [customerId], references: [id])
  lines         SaleOrderLine[]
  invoices      Invoice[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([customerId])
  @@map("sale_orders")
}

enum SaleOrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  READY
  DELIVERED
  INVOICED
  CANCELLED
}

model SaleOrderLine {
  id           String    @id @default(cuid())
  orderId      String
  productId    String
  description  String?
  quantity     Float
  unitPrice    Float
  discount     Float     @default(0)
  taxRate      Float     @default(0)
  subtotal     Float
  deliveredQty Float     @default(0)

  order        SaleOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product   @relation(fields: [productId], references: [id])

  @@map("sale_order_lines")
}

// ─────────────────────────────────────────
// VENDORS & PURCHASING
// ─────────────────────────────────────────

model Vendor {
  id           String          @id @default(cuid())
  code         String          @unique
  name         String
  email        String?
  phone        String?
  taxId        String?
  paymentTerms Int             @default(30)
  isActive     Boolean         @default(true)
  address      Json?
  notes        String?

  contacts     Contact[]
  purchaseOrders PurchaseOrder[]
  vendorBills  VendorBill[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("vendors")
}

model PurchaseOrder {
  id            String               @id @default(cuid())
  reference     String               @unique
  vendorId      String
  status        PurchaseOrderStatus  @default(DRAFT)
  orderDate     DateTime             @default(now())
  expectedDate  DateTime?
  subtotal      Float                @default(0)
  taxAmount     Float                @default(0)
  totalAmount   Float                @default(0)
  notes         String?

  vendor        Vendor               @relation(fields: [vendorId], references: [id])
  lines         PurchaseOrderLine[]
  bills         VendorBill[]
  receipts      GoodsReceipt[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@map("purchase_orders")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  CONFIRMED
  PARTIAL_RECEIVED
  RECEIVED
  BILLED
  CANCELLED
}

model PurchaseOrderLine {
  id           String        @id @default(cuid())
  orderId      String
  productId    String
  description  String?
  quantity     Float
  unitPrice    Float
  taxRate      Float         @default(0)
  subtotal     Float
  receivedQty  Float         @default(0)

  order        PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id])

  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id              String        @id @default(cuid())
  reference       String        @unique
  purchaseOrderId String
  receivedDate    DateTime      @default(now())
  notes           String?
  status          ReceiptStatus @default(DRAFT)

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  lines           GoodsReceiptLine[]
  createdAt       DateTime      @default(now())

  @@map("goods_receipts")
}

enum ReceiptStatus {
  DRAFT
  VALIDATED
  CANCELLED
}

model GoodsReceiptLine {
  id          String       @id @default(cuid())
  receiptId   String
  productId   String
  quantity    Float
  notes       String?

  receipt     GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@map("goods_receipt_lines")
}

// ─────────────────────────────────────────
// FINANCE & ACCOUNTING
// ─────────────────────────────────────────

model Account {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  type        AccountType
  normalSide  NormalSide
  isActive    Boolean       @default(true)
  description String?

  journalLines JournalLine[]
  createdAt   DateTime      @default(now())

  @@map("accounts")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalSide {
  DEBIT
  CREDIT
}

model Journal {
  id          String        @id @default(cuid())
  reference   String        @unique
  description String?
  date        DateTime
  status      JournalStatus @default(DRAFT)
  totalDebit  Float         @default(0)
  totalCredit Float         @default(0)
  sourceType  String?
  sourceId    String?

  lines       JournalLine[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("journals")
}

enum JournalStatus {
  DRAFT
  POSTED
  CANCELLED
}

model JournalLine {
  id          String   @id @default(cuid())
  journalId   String
  accountId   String
  description String?
  debit       Float    @default(0)
  credit      Float    @default(0)

  journal     Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account     Account  @relation(fields: [accountId], references: [id])

  @@map("journal_lines")
}

model Invoice {
  id           String        @id @default(cuid())
  reference    String        @unique
  customerId   String
  saleOrderId  String?
  type         InvoiceType   @default(INVOICE)
  status       InvoiceStatus @default(DRAFT)
  issueDate    DateTime      @default(now())
  dueDate      DateTime
  subtotal     Float         @default(0)
  taxAmount    Float         @default(0)
  totalAmount  Float         @default(0)
  paidAmount   Float         @default(0)
  notes        String?

  customer     Customer      @relation(fields: [customerId], references: [id])
  saleOrder    SaleOrder?    @relation(fields: [saleOrderId], references: [id])
  lines        InvoiceLine[]
  payments     Payment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("invoices")
}

enum InvoiceType {
  INVOICE
  CREDIT_NOTE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL_PAID
  PAID
  OVERDUE
  CANCELLED
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float
  unitPrice   Float
  taxRate     Float   @default(0)
  subtotal    Float

  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_lines")
}

model Payment {
  id            String        @id @default(cuid())
  reference     String        @unique
  invoiceId     String?
  vendorBillId  String?
  amount        Float
  method        PaymentMethod
  date          DateTime      @default(now())
  notes         String?

  invoice       Invoice?      @relation(fields: [invoiceId], references: [id])
  vendorBill    VendorBill?   @relation(fields: [vendorBillId], references: [id])
  createdAt     DateTime      @default(now())

  @@map("payments")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
  CREDIT_CARD
  ONLINE
}

model VendorBill {
  id             String      @id @default(cuid())
  reference      String      @unique
  vendorId       String
  purchaseOrderId String?
  status         BillStatus  @default(DRAFT)
  billDate       DateTime    @default(now())
  dueDate        DateTime
  totalAmount    Float       @default(0)
  paidAmount     Float       @default(0)
  notes          String?

  vendor         Vendor      @relation(fields: [vendorId], references: [id])
  purchaseOrder  PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  payments       Payment[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("vendor_bills")
}

enum BillStatus {
  DRAFT
  CONFIRMED
  PARTIAL_PAID
  PAID
  CANCELLED
}

// ─────────────────────────────────────────
// HR & PAYROLL
// ─────────────────────────────────────────

model Department {
  id          String     @id @default(cuid())
  name        String     @unique
  code        String     @unique
  managerId   String?
  isActive    Boolean    @default(true)

  employees   Employee[]
  createdAt   DateTime   @default(now())

  @@map("departments")
}

model Employee {
  id             String         @id @default(cuid())
  userId         String?        @unique
  employeeId     String         @unique
  firstName      String
  lastName       String
  email          String         @unique
  phone          String?
  departmentId   String?
  position       String
  employmentType EmploymentType @default(FULL_TIME)
  status         EmployeeStatus @default(ACTIVE)
  hireDate       DateTime
  terminateDate  DateTime?
  baseSalary     Float          @default(0)
  bankAccount    Json?
  address        Json?
  emergencyContact Json?

  user           User?          @relation(fields: [userId], references: [id])
  department     Department?    @relation(fields: [departmentId], references: [id])
  attendances    Attendance[]
  payrolls       PayrollLine[]
  leaveRequests  LeaveRequest[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("employees")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
  PROBATION
}

model Attendance {
  id          String    @id @default(cuid())
  employeeId  String
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  hoursWorked Float?
  type        AttendanceType @default(PRESENT)
  notes       String?

  employee    Employee  @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@map("attendances")
}

enum AttendanceType {
  PRESENT
  ABSENT
  HALF_DAY
  HOLIDAY
  WEEKEND
}

model LeaveRequest {
  id          String      @id @default(cuid())
  employeeId  String
  type        LeaveType
  startDate   DateTime
  endDate     DateTime
  days        Float
  reason      String?
  status      LeaveStatus @default(PENDING)
  approvedBy  String?
  approvedAt  DateTime?

  employee    Employee    @relation(fields: [employeeId], references: [id])
  createdAt   DateTime    @default(now())

  @@map("leave_requests")
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model PayrollRun {
  id          String        @id @default(cuid())
  reference   String        @unique
  period      String
  startDate   DateTime
  endDate     DateTime
  status      PayrollStatus @default(DRAFT)
  totalGross  Float         @default(0)
  totalDeductions Float     @default(0)
  totalNet    Float         @default(0)

  lines       PayrollLine[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("payroll_runs")
}

enum PayrollStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID
}

model PayrollLine {
  id           String     @id @default(cuid())
  payrollRunId String
  employeeId   String
  basicSalary  Float
  overtime     Float      @default(0)
  allowances   Float      @default(0)
  grossSalary  Float
  tax          Float      @default(0)
  sss          Float      @default(0)
  philhealth   Float      @default(0)
  pagibig      Float      @default(0)
  otherDeductions Float   @default(0)
  netSalary    Float
  notes        String?

  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id])
  employee     Employee   @relation(fields: [employeeId], references: [id])

  @@unique([payrollRunId, employeeId])
  @@map("payroll_lines")
}

// ─────────────────────────────────────────
// PRODUCTION / MRP
// ─────────────────────────────────────────

model BillOfMaterial {
  id                String    @id @default(cuid())
  reference         String    @unique
  finishedProductId String
  quantity          Float     @default(1)
  type              BomType   @default(MANUFACTURE)
  isActive          Boolean   @default(true)
  notes             String?

  finishedProduct   Product   @relation("BomFinishedProduct", fields: [finishedProductId], references: [id])
  lines             BomLine[]
  workOrders        WorkOrder[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("bills_of_material")
}

enum BomType {
  MANUFACTURE
  KIT
  SUBCONTRACTING
}

model BomLine {
  id          String         @id @default(cuid())
  bomId       String
  productId   String
  uomId       String
  quantity    Float
  notes       String?

  bom         BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)
  product     Product        @relation(fields: [productId], references: [id])
  uom         UnitOfMeasure  @relation(fields: [uomId], references: [id])

  @@map("bom_lines")
}

model WorkCenter {
  id           String      @id @default(cuid())
  name         String      @unique
  code         String      @unique
  capacity     Float       @default(1)
  costPerHour  Float       @default(0)
  isActive     Boolean     @default(true)
  workOrders   WorkOrder[]
  createdAt    DateTime    @default(now())

  @@map("work_centers")
}

model WorkOrder {
  id              String          @id @default(cuid())
  reference       String          @unique
  bomId           String
  workCenterId    String?
  quantity        Float
  producedQty     Float           @default(0)
  status          WorkOrderStatus @default(DRAFT)
  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  actualStart     DateTime?
  actualEnd       DateTime?
  notes           String?

  bom             BillOfMaterial  @relation(fields: [bomId], references: [id])
  workCenter      WorkCenter?     @relation(fields: [workCenterId], references: [id])
  lines           WorkOrderLine[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("work_orders")
}

enum WorkOrderStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  DONE
  CANCELLED
}

model WorkOrderLine {
  id          String    @id @default(cuid())
  workOrderId String
  productId   String
  required    Float
  consumed    Float     @default(0)

  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id])

  @@map("work_order_lines")
}
